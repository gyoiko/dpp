# Copy to .env and fill in real values. Never commit .env.
CMS_API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Legacy ERP SQL Server - READ ONLY
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=
# DPP traceability tables (T_溯源_*)
TRACE_DB_NAME=tesdatt5
# Server-side base URL used by the public /dpp/[milRef] page
DPP_API_BASE_URL=http://localhost:4000
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Set to true to serve sample rows without touching SQL Server
SUPPLY_CHAIN_MOCK=false

# Auth - JWT session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_SESSION_HOURS=8
# Set true only when the site is served over HTTPS.
AUTH_COOKIE_SECURE=false
# First admin is created on first login while the users table is empty.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# SQLite file used by `vinext start` on Node. Dev (`vinext dev`) uses the D1 binding instead.
# Defaults to data/dpp.sqlite when empty.
DPP_SQLITE_PATH=

# The CMS calls same-origin /api; the Vite dev server proxies it to :4000.
# For a separately deployed frontend, put the API behind the same origin
# (reverse proxy) or add a fetch base URL in app/cms/supply-chain/page.tsx.
